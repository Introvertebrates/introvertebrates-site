{% assign research_items = site.research | sort: "source_date" | reverse %}
{% for post in research_items %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    {% if post.posted_date %}<lastmod>{{ post.posted_date | date_to_xmlschema }}</lastmod>{% endif %}
    {% if post.feature_image and post.feature_image_alt %}
    <image:image>
      <image:loc>{{ post.feature_image | absolute_url }}</image:loc>
    </image:image>
    {% endif %}
  </url>
{% endfor %}
{% assign weekly_items = site.kryp_weekly | sort: "date" | reverse %}
{% for post in weekly_items %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    {% if post.date %}<lastmod>{{ post.date | date_to_xmlschema }}</lastmod>{% endif %}
    {% if post.image and post.image_alt %}
    <image:image>
      <image:loc>{{ post.image | absolute_url | escape }}</image:loc>
    </image:image>
    {% endif %}
  </url>
{% endfor %}
